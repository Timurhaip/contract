;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance) = $BorrowPool$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive Borrow message
    if (op == 490195545) {
        var $msg'idBorrow = in_msg~load_uint(64);
        var $msg'idComp = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_varuint16();
        var $msg'time = in_msg~load_int(1) ? in_msg~load_uint(32) : null();
        var $msg'to = in_msg~__tact_load_address_opt();
        var $msg'fcc = in_msg~load_varuint16();
        var $msg'balanceComp = in_msg~load_varuint16();
        var $msg'balanceBorrow = in_msg~load_varuint16();
        var ($init'code, $init'data) = $CompensationPool$_init_child($msg'idComp, $self'app);
        slice $childAddress = $global_contractAddress(($init'code, $init'data));
        throw_unless(14711, ( equal_slices_bits(__tact_context_get_sender(), $childAddress) ));
        throw_unless(40092, (($global_myBalance() - $msg'amount) >= 0));
        slice $userAddress = $global_login(__tact_not_null($msg'to), $self'app, null());
        int $time1 = $global_min(__tact_not_null($msg'time), $self'maxTime);
        $global_send($SendParameters$_constructor_to_value_mode_body($userAddress, $msg'amount, 1, $Borrow$_store_cell($Borrow$_constructor_idBorrow_idComp_amount_to_time_fcc_balanceComp_balanceBorrow($msg'idBorrow, $msg'idComp, $msg'amount, $msg'to, $time1, $msg'fcc, $msg'balanceComp, ($global_myBalance() - $Context$_get_value(__tact_context_get()))), begin_cell())));
        $global_send($SendParameters$_constructor_to_value_mode(__tact_not_null($msg'to), 0, 64));
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive InitBorrowPool message
    if (op == 1160199139) {
        var $msg'name = in_msg~load_ref().begin_parse();
        var $msg'maxTime = in_msg~load_uint(32);
        throw_unless(57255, ( equal_slices_bits(__tact_context_get_sender(), $self'app) ));
        $self'name = $msg'name;
        $self'maxTime = $msg'maxTime;
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive ChangeBorrow message
    if (op == 3634185715) {
        var $msg'balance = in_msg~load_varuint16();
        var $msg'id = in_msg~load_uint(32);
        cell $myCell = $Builder$_fun_endCell(store_uint($Builder$_fun_storeAddress($global_beginCell(), __tact_context_get_sender()), $msg'id, 32));
        int $sha256Hash = $Cell$_fun_hash($myCell);
        $self'borrowBalance~__tact_dict_set_int_coins(257, $sha256Hash, $msg'balance);
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive Repay message
    if (op == 1754501411) {
        var $msg'id = in_msg~load_uint(256);
        cell $myCell = $Builder$_fun_endCell(store_uint($Builder$_fun_storeAddress($global_beginCell(), __tact_context_get_sender()), $msg'id, 32));
        int $sha256Hash = $Cell$_fun_hash($myCell);
        int $poolBalance = __tact_not_null(__tact_dict_get_int_coins($self'borrowBalance, 257, $sha256Hash));
        int $sum = (($Context$_get_value(__tact_context_get()) * 110) / 104);
        int $comeback = ($sum - (($sum * 10) / 11));
        int $income = ((($sum - $comeback) * 4) / 10);
        $self'acc = ($self'acc + ((($income * 1000000000) / $poolBalance) / 10));
        $self'v = ($self'v + 1);
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive Withdraw message
    if (op == 180313183) {
        var $msg'from = in_msg~load_int(257);
        var $msg'from2 = in_msg~__tact_load_address_opt();
        var $msg'amount = in_msg~load_varuint16();
        var $msg'to1 = in_msg~__tact_load_address_opt();
        var ($init'code, $init'data) = $User$_init_child(__tact_not_null($msg'to1), $self'app);
        slice $userAddress = $global_contractAddress(($init'code, $init'data));
        throw_unless(14711, ( equal_slices_bits(__tact_context_get_sender(), $userAddress) ));
        slice $to1 = __tact_not_null($msg'to1);
        $global_send($SendParameters$_constructor_to_value($to1, $msg'amount));
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive Deposit message
    if (op == 507992258) {
        var $msg'id = in_msg~load_uint(32);
        var $msg'sender = in_msg~__tact_load_address_opt();
        throw_unless(57255, ( equal_slices_bits(__tact_context_get_sender(), $self'app) ));
        cell $data = $Builder$_fun_endCell(store_uint(store_uint(store_uint($Builder$_fun_storeCoins($Builder$_fun_storeAddress($global_beginCell(), $global_myAddress()), ($Context$_get_value(__tact_context_get()) - 10000000)), $self'v, 32), $self'acc, 32), 0, 32));
        slice $userAddress = $global_login(__tact_not_null($msg'sender), $self'app, null());
        $global_send($SendParameters$_constructor_to_value_body($userAddress, 10000000, $ChangeVal$_store_cell($ChangeVal$_constructor_val_newVal_initiator(3, $data, __tact_not_null($msg'sender)), begin_cell())));
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive UpdateEarn message
    if (op == 584289618) {
        var $msg'sender = in_msg~load_msg_addr();
        cell $data2 = $Builder$_fun_endCell($Builder$_fun_storeCoins(store_uint(store_uint(store_uint($global_beginCell(), 0, 2), $self'id, 32), $self'v, 32), $self'acc));
        slice $address = $global_login($msg'sender, $self'app, null());
        $global_updateFunc($address, $data2, 5, $msg'sender);
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive Deploy message
    if (op == 0x946a98b6) {
        var $deploy'queryId = in_msg~load_uint(64);
        ($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance)~$BorrowPool$_fun_notify($DeployOk$_store_cell($DeployOk$_constructor_queryId($deploy'queryId), begin_cell()));
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $BorrowPool$_contract_store(($self'id, $self'name, $self'maxTime, $self'app, $self'acc, $self'v, $self'borrowBalance));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}


() __tact_selector_hack_asm() impure asm """
@atend @ 1 {
        execute current@ context@ current!
        {
            // The core idea of this function is to save gas by avoiding unnecessary dict jump, when recv_internal/recv_external is called
            // We want to extract recv_internal/recv_external from the dict and select needed function
            // not by jumping to the needed function by it's index, but by using usual IF statements.

            }END> b> // Close previous builder, now we have a cell of previous code on top of the stack

            <{ // Start of the new code builder
                SETCP0
                // Swap the new code builder with the previous code, now we have previous code on top of the stack
                swap
                // Transform cell to slice and load first ref from the previous code, now we have the dict on top of the stack
                <s ref@

                // Extract the recv_internal from the dict
                dup 0 swap @procdictkeylen idict@ { "internal shortcut error" abort } ifnot
                swap

                // Delete the recv_internal from the dict
                0 swap @procdictkeylen idict- drop
                // Delete the recv_external from the dict (it's okay if it's not there)
                -1 swap @procdictkeylen idict- drop
                // Delete the __tact_selector_hack from the dict
                65535 swap @procdictkeylen idict- drop

                // Bring the code builder from the bottom of the stack
                // because if recv_external extraction is optional, and the number of elements on the stack is not fixed
                depth 1- roll
                // Swap with the dict from which we extracted recv_internal and (maybe) recv_external
                swap

                // Check if the dict is empty
                dup null?
                // Store a copy of this flag in the bottom of the stack
                dup depth 1- -roll
                {
                    // If the dict is empty, just drop it (it will be null if it's empty)
                    drop
                }
                {
                    // If the dict is not empty, prepare continuation to be stored in c3
                    <{
                        // Save this dict as first ref in this continuation, it will be pushed in runtime by DICTPUSHCONST
                        swap @procdictkeylen DICTPUSHCONST
                        // Jump to the needed function by it's index
                        DICTIGETJMPZ
                        // If such key is not found, throw 11 along with the key as an argument
                        11 THROWARG
                    }> PUSHCONT
                    // Store the continuation in c3
                    c3 POP
                } cond

                // Function id is on top of the (runtime) stack
                DUP IFNOTJMP:<{
                    // place recv_internal here
                    DROP swap @addop
                }>

                // Bring back the flag, indicating if the dict is empty or not from the bottom of the stack
                depth 1- roll
                {
                    // If the dict is empty, throw 11
                    11 THROWARG
                }
                {
                    // If the dict is not empty, jump to continuation from c3
                    c3 PUSH JMPX
                } cond
            }> b>
        } : }END>c
        current@ context! current!
    } does @atend !
""";

() __tact_selector_hack() method_id(65535) {
    return __tact_selector_hack_asm();
