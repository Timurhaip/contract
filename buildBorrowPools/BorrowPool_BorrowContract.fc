(int, slice, int, int, int, slice, int) $BorrowContract$_contract_init(slice $address, int $pool, slice $app, int $id) impure inline {
    var (($self'id, $self'address, $self'createdTime, $self'pool, $self'sum, $self'app, $self'endTime)) = (null(), null(), null(), null(), null(), null(), null());
