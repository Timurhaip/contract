(cell, cell) $User$_init_child(slice $addressUser, slice $app) inline_ref {
    ;; Build init code cell

    slice sc' = __tact_child_contract_codes.begin_parse();
    cell source = sc'~load_dict();
    ;; Contract Code: User
    cell init_code = __tact_dict_get_code(source, 57900);

    ;; Build init data cell
    cell contracts = new_dict();

    ;; Contract Code: CompensationPool
    cell code_21538 = __tact_dict_get_code(source, 21538);
    contracts = __tact_dict_set_code(contracts, 21538, code_21538);

    ;; Contract Code: RequestContract
    contracts = __tact_dict_set_code(contracts, 42506, my_code());

    ;; Contract Code: BorrowContract
    cell code_55931 = __tact_dict_get_code(source, 55931);
    contracts = __tact_dict_set_code(contracts, 55931, code_55931);

    ;; Contract Code: BorrowPool
    cell code_33759 = __tact_dict_get_code(source, 33759);
    contracts = __tact_dict_set_code(contracts, 33759, code_33759);

    builder b = begin_cell();
    b = b.store_builder_ref(begin_cell().store_dict(contracts));
    b = b.store_int(false, 1);
    b = $User$init$_store(b, ($addressUser, $app));
    return (init_code, b.end_cell());
}

