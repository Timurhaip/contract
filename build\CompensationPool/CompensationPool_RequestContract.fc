slice $global_login(slice $address, slice $app, int $create) impure inline_ref {
    var ($init'code, $init'data) = $User$_init_child($address, $app);
    slice $contractAddress = $global_contractAddress(($init'code, $init'data));
    if ((~ null?($create))) {
        $global_send($SendParameters$_constructor_to_value_code_data_body($contractAddress, 20000000, $init'code, $init'data, $global_emptyCell()));
        return $contractAddress;
    }
    return $contractAddress;
}

